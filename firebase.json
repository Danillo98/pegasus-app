{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/termos",
        "destination": "/termos.html"
      },
      {
        "source": "/termos/",
        "destination": "/termos.html"
      },
      {
        "source": "/politicas",
        "destination": "/politicas.html"
      },
      {
        "source": "/politicas/",
        "destination": "/politicas.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
